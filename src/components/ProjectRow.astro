---
/** One full-width project row (mockup layout C): code, status light, title, blurb, stat, OPEN. */
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const status = project.statusNote ? `${project.status} · ${project.statusNote}` : project.status;
---

<a class="rowc" data-p={project.accent} href={project.url}>
  <span class="spot" aria-hidden="true"></span>
  <div class="meta"><span class="code">{project.host}</span><span class="status">{status}</span></div>
  <div>
    <h3>{project.title}</h3>
    <p>{project.description}</p>
    <div class="stat">{project.stat}</div>
  </div>
  <span class="go">OPEN →</span>
</a>
